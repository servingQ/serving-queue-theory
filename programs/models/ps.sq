// Adapted from serQ v0.1.4 (a99dd649), ported to v0.1.6: explicit SQT experiment inputs.
// M/G/1 processor sharing (paper `prop:decode`, insensitivity): the mean
// number in the station is rho/(1-rho) whatever the service law.
// The turns are `../workloads/ps.sq`.

fn main() {
  stage svc : ps(1);

  server (s, t0) {
    run svc (cost(svc, s));
    observe response = now - t0;
  }
}
