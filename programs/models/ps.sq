// Adapted from serQ v0.1.4 (a99dd649): explicit SQT experiment inputs.
// M/G/1 processor sharing (paper `prop:decode`, insensitivity): the mean
// number in the station is rho/(1-rho) whatever the service law.

use "std/args";

fn main() {
  let lam = args.number("lam", 0.7);
  let mean_s = args.number("mean_s", 1.0);
  let cv2 = args.number("cv2", 9.0);
  let law = args.number("law", 1);

  stage svc : ps(1);

  workload {
    arrive poisson(lam);
    init {
      set t0 = now;
      set s = law == 0 ? mean_s
      : law == 1 ? ~exp(mean_s)
      : law == 2 ? ~erlang(4, mean_s)
      : ~h2(mean_s, cv2);
    }

  }

  server {
    run svc (cost(svc, s));
    observe response = now - t0;
  }
}
