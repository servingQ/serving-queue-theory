// Adapted from serQ v0.1.4 (a99dd649): explicit SQT experiment inputs.
// Closed loop of N sessions over one FIFO server with exponential work
// (mean 1/mu) and an exponential think time (mean Z): the M/M/1//N
// finite-source queue of paper `prop:finite` (mean value analysis).

use "std/args";

fn main() {
  let N = args.number("N", 8);
  let mu = args.number("mu", 1.0);
  let Z = args.number("Z", 4.0);

  stage svc : fifo;
  stage think : delay;

  workload {
    arrive closed(N);
    session {
      loop {
        set t0 = now;
        set s = ~exp(1 / mu);
        turn;
        run think (cost(think, ~exp(Z)));
      }
    }
  }

  server {
    run svc (cost(svc, s));
    observe wait = now - t0 - s;
    observe response = now - t0;
  }
}
