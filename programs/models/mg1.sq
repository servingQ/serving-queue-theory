// Adapted from serQ v0.1.4 (a99dd649), ported to v0.1.6: explicit SQT experiment inputs.
// M/G/1 FIFO (paper §2, `prop:pk`): Poisson turns at rate `lam`,
// `servers` servers (one: M/G/1), i.i.d. service of mean `mean_s` drawn
// by `law` (0 deterministic, 1 exponential, 2 Erlang-4, 3 balanced H2 with
// `cv2`), or by any law given as `--def service=...`. The turns and their
// service are `../workloads/mg1.sq`.
use "std/args";

fn main() {
  let servers = args.number("servers", 1);

  stage svc : fifo(servers);

  server (s, t0) {
    run svc (cost(svc, s));
    observe response = now - t0;
    observe wait = now - t0 - s;
    observe service_time = s;
  }
}
