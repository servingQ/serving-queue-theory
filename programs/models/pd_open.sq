// Adapted from serQ v0.1.4 (a99dd649): explicit SQT experiment inputs.
// Open-arrival aggregated pool vs prefill -> KV link -> decode tandem.

use "std/args";

fn main() {
  let N = args.number("N", 32);
  let NP = args.number("NP", 11);
  let Lambda = args.number("Lambda", 1.0);
  let sP = args.number("sP", 1.0);
  let sD = args.number("sD", 1.0);
  let I = args.number("I", 0.5);
  let gP = args.number("gP", 2.0);
  let gD = args.number("gD", 1.0);
  let bnet = args.number("bnet", 1000.0);
  let K = args.number("K", 1.0);
  let mode = args.number("mode", 1); // 0 aggregated, 1 disaggregated

  // the laws, by name (`--def prefill_work='~erlang(4, sP)'`)
  def prefill_work() { ~exp(sP) }
  def decode_work() { ~exp(sD) }
  def kv_tokens() { ~exp(K) }

  stage agg : fifo(max(N, 1));
  stage prefill : fifo(max(NP, 1));
  stage link : fifo;
  stage decode : fifo(max(N - NP, 1));

  workload {
    arrive poisson(Lambda);
  }

  server {
    set t0 = now;
    set sp = prefill_work();
    set sd = decode_work();
    set kv = kv_tokens();
    branch (mode == 0) {
      run agg (cost(agg, sp + sd + I));
    } else {
      run prefill (cost(prefill, sp / gP));
      run link (cost(link, kv / bnet));
      run decode (cost(decode, sd / gD));
    }
    observe response = now - t0;
  }
}
