// Paper agentic queue. The Python adapter (sim.agentic) gives the defs below
// their bodies (`defs=`): the eviction key, the spill and fetch conditions
// here, and the class of a new program and its laws in the workload
// (`workloads/agentic_model.sq`); serQ owns the event loop, queues, cache
// and transfer stages.
use "std/args";

fn main() {
  let C = args.number("C", 4e5);
  let s0 = args.number("s0", 0.005);
  let a = args.number("a", 2e-5);
  let b = args.number("b", 2e-9);
  let d = args.number("d", 2e-4);
  let dv = args.number("dv", 0);
  let bw = args.number("bw", 1e6);
  let blocking = args.number("blocking", 0);

  // the policies: the eviction key after `waiting`, when a victim spills to the
  // tier, when a turn fetches its spilled KV (they may read the class's
  // `p`, `tau`, `mean_new`, `mean_out`, which a request carries)
  def evict_key() { size }
  def spills() { 0 }
  def fetches() { 1 }

  pool slot { cap 1; }
  pool tier { cap inf; }
  pool kv {
    cap C;
    evict by (waiting, evict_key());
    spill tier via link (size / bw) when (spills());
  }

  stage svc : fifo;
  stage link : fifo;

  // a session's last request says so (`final`); the server frees its KV
  server (K, n, o, cold, t0, final, p, tau, mean_new, mean_out) reply (rejected) {
    set rejected = K + n + o > C;
    if (rejected) { observe truncated = 1; drop kv; drop tier; } else {
      set staged = 0;
      set stalled = 0;
      if (cachedin(tier) > 0 && blocking == 0 && fetches()) {
        run link (cost(link, K / bw));
        set staged = 1;
        observe fetched = 1;
        drop tier;
      }
      set enqueued = now;
      hold slot (cost(slot, 1)) {
        observe wait = now - enqueued;
        if (cachedin(tier) > 0 && blocking == 1 && fetches()) {
          set fetch_start = now;
          run link (cost(link, K / bw));
          set stalled = now - fetch_start;
          set staged = 1;
          observe fetched = 1;
          drop tier;
        }
        if (cachedin(tier) > 0 && !staged) { drop tier; }
        hold kv (cost(kv, K + n + o)) {
          set warm = !cold && (cached >= K || staged);
          set P = warm ? a * n + b * n * (K + n / 2)
          : a * (K + n) + b * (K + n) * (K + n) / 2;
          set S = s0 + P + o * (d + dv * (K + n));
          set recompute = !cold && !warm ? a * K + b * K * K / 2 : 0;
          run svc (cost(svc, S));
        } cache (cost(kv, K + n + o));
        observe service = S + stalled;
        observe recompute_work = recompute;
        observe stall = stalled;
      }
      observe response = now - t0;
      if (!cold) { observe hit = warm; }
      if (final) { drop kv; drop tier; }
    }
  }
}
