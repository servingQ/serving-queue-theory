// Where the price of a miss is paid, on a replica with the vLLM v1 engine's
// rules: the check `prefill_pays_the_miss` (paper App. B, `tab:sim-ps`
// rows 8-9, §4.2), generated by sim.price_vllm.
//
// Poisson turns, no memory limit, the testbed's cost model. A turn is a hit
// with `hitn` new tokens or a miss with `missn` (its context recomputed),
// decided by one uniform draw at arrival, so that a run with a share
// `delta` of forced misses sees the same arrivals and draws (common random
// numbers): a turn misses when u < pmiss + delta. Prefill runs in the
// budget the decoding turns leave, in admission order; decode takes `o`
// iterations. Props. price and decode say: the forced misses raise the
// number in the prefill stage (λ TTFT) by an amount inside the FIFO
// bracket at the stage's effective service, and leave the number in the
// decode stage (λ (R - TTFT)) unchanged.

let Lambda = 1.0;      // turns per second
let pmiss = 0.2;       // baseline miss share
let delta = 0;         // forced misses
let hitn = 512;        // tokens prefilled by a hit
let missn = 5120;      // tokens prefilled by a miss
let o = 8;             // output tokens
let B = 64;            // batch cap
let bs = 16;
let a = 1.94e-4;       // s per prefill token
let b = 6.51e-9;       // s per prefill token per context token
let omega = 0.057;     // s per decode iteration

pool slots { cap B; admit via engine; }
pool kv { cap 1e12; block bs; preempt lifo; evict lru; }
stage engine : step {
  budget max(decoders, floor(omega / a));
  cost max(omega, tokens * a + b * attention);
  memory kv;
}

workload {
  arrive poisson(Lambda);
  init { set u = ~uniform(0, 1); }
}

session {
  set t0 = now;
  set m = u < pmiss + delta ? missn : hitn;
  observe work = a * m + b * m * m / 2;
  hold slots (1), kv (min(m, budget_left(engine))) reserve (m) {
    run engine prefill (m) growing kv;
    observe ttft = now - t0;
    run engine decode (o - 1) growing kv;
  }
  observe response = now - t0;
  drop kv;
  end;
}

run { horizon 200000; warmup 2000; seed 1; }
