// Where the price of a miss is paid, on a replica with the vLLM v1 engine's
// rules: the check `prefill_pays_the_miss` (paper App. B, `tab:sim-ps`
// rows 8-9, §4.2), generated by sim.price_vllm.
//
// Poisson turns, no memory limit, the testbed's cost model. A turn is a hit
// with `hitn` new tokens or a miss with `missn` (its context recomputed),
// decided by one uniform draw at arrival, so that a run with a share
// `delta` of forced misses sees the same arrivals and draws (common random
// numbers): a turn misses when u < pmiss + delta. Prefill runs in the
// budget the decoding turns leave, in admission order; decode takes `o`
// iterations. Props. price and decode say: the forced misses raise the
// number in the prefill stage (λ TTFT) by an amount inside the FIFO
// bracket at the stage's effective service, and leave the number in the
// decode stage (λ (R - TTFT)) unchanged.

use "std/args";

fn main() {
  let Lambda = args.number("Lambda", 1.0);      // turns per second
  let pmiss = args.number("pmiss", 0.2);       // baseline miss share
  let delta = args.number("delta", 0);         // forced misses
  let hitn = args.number("hitn", 512);        // tokens prefilled by a hit
  let missn = args.number("missn", 5120);      // tokens prefilled by a miss
  let o = args.number("o", 8);             // output tokens
  let B = args.number("B", 64);            // batch cap
  let bs = args.number("bs", 16);
  let a = args.number("a", 1.94e-4);       // s per prefill token
  let b = args.number("b", 6.51e-9);       // s per prefill token per context token
  let omega = args.number("omega", 0.057);     // s per decode iteration

  device gpu { kv cap 1e12; }
  engine vllm on gpu {
    slots cap B;
    tokens cap max(running.decoding, floor(omega / a));
    scheduler {
      advance running;
      admit waiting while (running.preempted == 0)
        taking slots (1), kv (min(request.known, budget_left(vllm))) reserve (request.known);
    }
    worker {
      forward (max(omega, batch.tokens * a + b * batch.attention));
    }
  }
  pool slots on vllm { queue fifo; }
  pool kv on gpu { block bs; preempt lifo; evict lru; }

  workload {
    arrive poisson(Lambda);
    init { set u = ~uniform(0, 1); }
  }

  server {
    set t0 = now;
    set m = u < pmiss + delta ? missn : hitn;
    observe work = a * m + b * m * m / 2;
    vllm (m, o);
    observe ttft = vllm.first - t0;
    observe response = now - t0;
    drop kv;
  }
}
