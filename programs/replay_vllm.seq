// §4.2's replica (paper/simulation.tex; generated by
// libqueuingsim/examples/paper_tables.rs through libqueuingsim::seq_replay):
// the production sessions of the WEKA corpus on a replica with the vLLM v1
// engine's rules (the ones the request-for-request comparison with the real
// scheduler established, seQ `docs/language.md` §7), a live-session cap,
// the RBLN-calibrated time model and eviction by price per byte-second.
// research/seq-replay42.md compares it with libqueuingsim's rules.
//
// Engine rules, replacing libqueuingsim's:
//  * the engine admits waiting turns at the start of an iteration with the
//    budget its residents leave (`admit via engine`), never in an iteration
//    that preempted, and serves residents in admission order (no `decode
//    first`);
//  * admission needs room for the whole prompt (`reserve`), but allocates only
//    the reused prefix plus the first chunk, and the hold grows with every
//    computed token (`growing kv`); a growth that does not fit preempts the
//    most recently admitted turn (`preempt lifo`), which re-queues at the
//    head and recomputes;
//  * the KV pool is blocks of 16 tokens, evicted from an entry's tail; a
//    turn reuses at most the full blocks of its previous context (below
//    the last prompt token), the rest of its entry stays cached, dead;
//    every computed token is cached (`cache (prompt + out - 1)`);
//  * a finished session's blocks stay cached (vLLM cannot tell that the
//    session ended; `keep = 0` drops them, an ablation); `lru = 1` evicts
//    least recently released first (what vLLM does) instead of by price.
// The first token comes from the prefill; decode computes the other
// `out - 1`. The prefill's fixed overhead c0 is engine time spent before
// the prompt's tokens (it grows no KV).

let Lambda = 0.001;
let cap = 24;
let B = 8;
let C = 1e15;
let maxctx = 0.9 * C;
let bs = 16;           // block size (tokens)
let c0 = 0.044;
let a = 1.94e-4;
let b = 6.51e-9;
let omega = 0.057;
let p = 0.9711687819662815;
let tau = 22.65186432082386;
let lru = 0;           // 1: vLLM's LRU order instead of the price
let keep = 1;          // 0: drop a finished session's blocks (ablation of vLLM's rule)
let delta = 0;         // share of follow-up turns forced to miss (§4.2's price table)

pool live { cap cap; }
pool slots { cap B; admit via engine; }
pool kv {
  cap C;
  block bs;
  preempt lifo;
  evict by (lru ? 0 : queued,
            lru ? last
                : (queued ? 1 : p) * price(engine, c0, a * size + b * size * size / 2)
                  / (size * (queued ? 1 : tau)));
}
// the time model of the paper's cost fit in real tokens: an iteration
// of ntok tokens (the overhead counted in tokens of `a`) and attention attn
// takes max(ω, a ntok + b attn)
stage engine : step {
  budget max(ndec, floor(omega / a));   // whole tokens (ω/a = 293.8)
  cost max(omega, ntok * a + b * attn);
  memory kv;
}
stage tool : delay;

workload {
  arrive poisson(Lambda);
  trace "../libqueuingsim/data/weka-sessions.csv";
}

session {
  set t_arr = now;
  hold live (1) {
    observe entry_wait = now - t_arr;
    set K = 0;
    set cold = 1;
    turn;
    loop {
      set t0 = now;
      set prompt = K + new;
      // reusable: the full blocks of the previous turn's computed tokens (K - 1:
      // the last output token is never computed into the KV)
      set hm0 = cold ? 0 : floor(min(K - 1, prompt - 1) / bs) * bs;
      // a forced miss (a nonce at the head of the prompt) reuses nothing; the
      // old blocks stay cached, dead
      set fm = cold ? 0 : ~bernoulli(delta);
      set hitmax = fm ? 0 : hm0;
      hold slots (1), kv (min(cachedin(kv), hitmax)
                          + min(prompt - min(cachedin(kv), hitmax), budget_left(engine)))
                      reserve (prompt)
           reuse (hitmax) {
        set c = cached;
        set m = prompt - c;
        // 0 cold, 1 hit (the whole reusable prefix reused), 2 miss (partly or all)
        set kind = cold ? 0 : (c >= hm0 ? 1 : 2);
        observe kind = kind;
        observe work = c0 + a * m + b * m * (c + m / 2);
        run engine prefill (ceil(c0 / a));
        run engine prefill (m) growing kv;
        observe ttft = now - t0;
        branch (!cold) {
          observe hit = kind == 1;
          observe reused = hm0 > 0 ? c / hm0 : 1;
          observe forced = fm;
          // the work had the turn reused its whole reusable prefix
          observe whit = c0 + a * (prompt - hm0) + b * (prompt - hm0) * (hm0 + (prompt - hm0) / 2);
        }
        run engine decode (out - 1) growing kv;
        observe done = now - t0;
      } cache (prompt + out - 1);
      set K = prompt + out;
      set cold = 0;
      branch (K > maxctx) {
        observe trunc = 1;
        branch (keep) { end; } else { drop kv; end; }
      }
      branch (more) { run tool (think); turn; } else { branch (keep) { end; } else { drop kv; end; } }
    }
  }
}

run { horizon 66000; warmup 6000; seed 1; }
