// serQ v0.1.0: the analytical tandem of the unified lecture notes:
// a turn waits for KV memory at the prefill instance, is prefilled one at a
// time in arrival order, ships its KV over a link whose bandwidth concurrent
// transfers share, waits for memory at the decode instance, decodes in a
// batch that shares the instance's throughput, and after a tool call
// comes back for the next turn, a hit if its prefix is still cached.
use "std/args";

fn main() {
  let Lambda = args.number("Lambda", 0.5);     // sessions per second
  let p = args.number("p", 0.8);          // continue after a turn
  let kappa = args.number("kappa", 1.0);      // memory units per context token
  let MP = args.number("MP", 4e5);         // prefill-instance pool
  let MD = args.number("MD", 4e5);         // decode-instance pool
  let a = args.number("a", 2e-5);         // prefill (s/token)
  let b = args.number("b", 2e-9);         // prefill (s/token^2)
  let x0 = args.number("x0", 0.002);       // link overhead (s)
  let Bw = args.number("Bw", 2e6);         // link bandwidth (memory units/s)
  let w = args.number("w", 2e-4);         // decode: seconds per token of the batch
  let phi_cap = args.number("phi_cap", 16);     // decode batch capacity phi(m) = min(m, phi_cap)

  pool memP { cap MP; evict lru; }
  pool memD { cap MD; }

  stage prefill : fifo;
  stage link : ps(1);
  stage decode : ps(min(present, phi_cap));
  stage tool : delay;

  workload {
    arrive poisson(Lambda);
    init { set K = 0; }
    turn {
      // the next turn's new tokens contain the previous output (n' >= o)
      set n = K == 0 ? ~uniform(2000, 6000) : o + ~exp(500);
      set o = ~exp(200);
      set Z = ~exp(3);
      set T = K + n;
    }
    session {
      loop {
        turn;
        set K = T;
        branch with (p) { tool Z; } else { end; }
      }
    }
  }

  server {
    set t0 = now;
    hold memP (cost(memP, kappa * T)) {
      // the hit indicator is decided at admission: the cached memory covers the prefix
      set H = cached >= kappa * K;
      set S = H ? a * n + b * n * (K + n / 2) : a * T + b * T * T / 2;
      observe miss = 1 - H;
      prefill S;
      observe ttft = now - t0;
      run link (cost(link, x0 + kappa * T / Bw));
    } cache (cost(memP, kappa * T));
    hold memD (cost(memD, kappa * T)) {
      decode (o * w);
    }
    observe response = now - t0;
  }
}
