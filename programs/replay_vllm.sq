// §4.2's replica (paper/simulation.tex; generated by
// report.paper_tables through sim.replay_vllm):
// the production sessions of the WEKA corpus on a replica with the vLLM v1
// engine's rules (the ones the request-for-request comparison with the real
// scheduler established, serQ `docs/language.md` §7), a live-session cap,
// the RBLN-calibrated time model and eviction by price per byte-second.
// research/serq-replay42.md compares it with the old validation model's rules.
//
// Engine rules, replacing the old validation model's:
//  * the engine admits waiting turns in an iteration with the budget its
//    residents leave (`pool slots on vllm`), never in an iteration that
//    preempted, and serves residents in admission order (no `decode
//    first`);
//  * admission needs room for the whole prompt (`reserve`), but allocates only
//    the reused prefix plus the first chunk, and the hold grows with every
//    computed token; a growth that does not fit preempts the most recently
//    admitted turn (`preempt lifo`), which re-queues at the head, keeps its
//    generated tokens and recomputes their KV (scheduler.py:1560-1561);
//  * the KV pool is blocks of 16 tokens, evicted from an entry's tail; a
//    turn reuses at most the full blocks of its previous context (below
//    the last prompt token), the rest of its entry stays cached, dead;
//    cache the context except its final token (`cache (prompt + out - 1)`);
//  * a finished session's blocks stay cached (vLLM cannot tell that the
//    session ended; `keep_cache = 0` drops them, an ablation); `lru = 1` evicts
//    least recently released first (what vLLM does) instead of by price.
// The first token comes from the prefill; decode computes the other
// `max(out - 1, 0)` (the corpus also has zero-output turns). The prefill's
// fixed overhead c0 is engine time of the iteration that admits the turn
// (it grows no KV and takes no budget).
//
// The sessions, their live-session cap and context limit are
// `workloads/replay_vllm.sq`; a request carries the context K, the trace's
// `new` and `out`, whether it is the session's first and whether its last.

use "std/args";

fn main() {
  let B = args.number("B", 8);
  let C = args.number("C", 1e15);
  let bs = args.number("bs", 16);           // block size (tokens)
  let c0 = args.number("c0", 0.044);
  let a = args.number("a", 1.94e-4);
  let b = args.number("b", 6.51e-9);
  let omega = args.number("omega", 0.057);
  let p = args.number("p", 0.9711687819662815);
  let tau = args.number("tau", 22.65186432082386);
  let lru = args.number("lru", 0);           // 1: vLLM's LRU order instead of the price
  let keep_cache = args.number("keep_cache", 1);          // 0: drop a finished session's blocks (ablation of vLLM's rule)
  let delta = args.number("delta", 0);         // share of follow-up turns forced to miss (§4.2's price table)

  device gpu { kv cap C; }
  // the time model of the paper's cost fit in real tokens: an iteration
  // of ntok tokens and attention attn, admitting nadm turns, takes
  // max(ω, a ntok + c0 nadm + b attn)
  engine vllm on gpu {
    slots cap B;
    tokens cap max(running.decoding, floor(omega / a));   // whole tokens (ω/a = 293.8)
    state newcomers = 0;   // the turns this iteration admitted
    scheduler {
      advance running;
      // a slot and the reused prefix plus the first chunk, if the whole
      // prompt fits; a turn reuses at most `hitmax`, and caches its context
      // but the final token
      admit waiting while (running.preempted == 0)
        taking slots (1), kv (request.hit + min(request.known - request.hit, budget_left(vllm)))
          reserve (request.known)
        reuse (hitmax)
        cache (prompt + out - 1);
      set newcomers = waiting.admitted;
    }
    worker {
      forward (max(omega, a * batch.tokens + c0 * newcomers + b * batch.attention));
    }
  }
  pool slots on vllm { queue fifo; }
  pool kv on gpu {
    block bs;
    preempt lifo;
    evict by (lru ? 0 : waiting,
    lru ? last
    : (waiting ? 1 : p) * price(vllm, c0, a * size + b * size * size / 2)
    / (size * (waiting ? 1 : tau)));
  }

  server (K, new, out, cold, final) {
    set t0 = now;
    set prompt = K + new;
    // reusable: the full blocks of the previous turn's computed tokens (K - 1:
    // the last output token is never computed into the KV)
    set hm0 = cold ? 0 : floor(min(K - 1, prompt - 1), bs);
    // a forced miss (a nonce at the head of the prompt) reuses nothing; the
    // old blocks stay cached, dead
    set fm = cold ? 0 : ~bernoulli(delta);
    set hitmax = fm ? 0 : hm0;
    vllm (prompt, max(out, 1));   // the prefill samples the first token, of a zero-output turn too
    set c = vllm.reused;
    set m = prompt - c;
    // 0 cold, 1 hit (the whole reusable prefix reused), 2 miss (partly or all)
    set outcome = cold ? 0 : (c >= hm0 ? 1 : 2);
    observe kind = outcome;
    observe work = c0 + a * m + b * m * (c + m / 2);
    observe ttft = vllm.first - t0;
    if (!cold) {
      observe hit = outcome == 1;
      observe reused = hm0 > 0 ? c / hm0 : 1;
      observe forced_miss = fm;
      // the work had the turn reused its whole reusable prefix
      observe whit = c0 + a * (prompt - hm0) + b * (prompt - hm0) * (hm0 + (prompt - hm0) / 2);
    }
    observe done = now - t0;
    if (final && keep_cache == 0) { drop kv; }
  }
}
