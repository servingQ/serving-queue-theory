// The single-turn replica of `sim.agentic`: N closed
// agent programs cycle queue -> service (prefill + decode) -> tool call on
// one FIFO replica with a finite KV pool of C tokens. Memory is taken when
// service starts (the `slot` pool is the replica's queue), evicting
// suspended programs shortest-first, tool calls before queued programs.
// A follow-up turn is a hit iff its whole context is still resident.
// The workload is `workloads/agentic.sq` (`pairs.json`).
use "std/args";

fn main() {
  let C = args.number("C", 4e5);
  let s0 = args.number("s0", 0.005);   // per-turn overhead (s)
  let a = args.number("a", 2e-5);     // prefill, linear (s/token)
  let b = args.number("b", 2e-9);     // prefill, quadratic (s/token^2)
  let d = args.number("d", 2e-4);     // decode (s/token)

  pool slot { cap 1; }
  pool kv { cap C; evict by (waiting, size); }

  stage svc : fifo;

  // the validation package frees a finished session's KV: the session's
  // last request says so (`final`), and the server drops it
  server (K, n, o, cold, final) {
    set t0 = now;
    hold slot (cost(slot, 1)) {
      hold kv (cost(kv, K + n + o)) {
        set warm = !cold && cached >= K;
        set S = s0 + o * d
        + (warm ? a * n + b * n * (K + n / 2)
        : a * (K + n) + b * (K + n) * (K + n) / 2);
        run svc (cost(svc, S));
      } cache (cost(kv, K + n + o));
    }
    observe response = now - t0;
    observe service = S;
    if (!cold) { observe hit = warm; }
    if (final) { drop kv; }
  }
}
