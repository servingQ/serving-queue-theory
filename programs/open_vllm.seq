// Open agent sessions on a replica with the vLLM v1 engine's rules: the
// synthetic eviction and admission experiment of §4.2 / App. B
// (`tab:sim-evict-dyn`, `tab:sim-admission`, `fig:sim-admission`;
// generated by validation.paper_tables through
// validation.seq_open). The engine rules are those of
// `replay_vllm.seq`; the workload is the two-class open-session one of the
// validation package; the time model is the testbed's cost fit.
//
// Workload: Poisson sessions, two classes of equal weight. Agents resume
// with p = 0.95 after tool calls of Exp(6 s), start from 4-8k tokens and
// append Exp(800) per turn; documents resume with p = 0.3 after Exp(2 s),
// start from 15-30k tokens and append Exp(500); every turn decodes
// Exp(300) tokens. The different tool times let the byte-second price and
// the per-token price order the two classes differently.
//
// Eviction (`policy`), in 16-token blocks from the tail of a context,
// sessions in a tool call before waiting ones except under LRU, with
// q = p (tool call) or 1 (waiting) and τ = Z (tool call) or 1 (waiting):
//   0 shortest first (size), 1 density q P(c)/c, 2 priced q Φ/c,
//   3 priced per byte-second q Φ/(c τ), 4 the same on the tail block,
//   5 least recently used (what vLLM does).
// Φ is the online price of a miss at the engine (`price`), with the hit
// prefill of a mean append onto the context as S^hit and the recompute of
// the context, P(c) = a c + b c^2 / 2, as the added work. The priced keys
// read p and τ of the generating class (an oracle); the fixed keys do not.

let Lambda = 0.02;     // sessions per second
let cap = 24;          // live sessions (entry queue beyond)
let B = 8;             // batch cap
let C = 6e5;           // KV pool, tokens
let maxctx = 0.5 * C;  // a session whose context passes this ends
let bs = 16;           // block size (tokens)
let c0 = 0.044;        // s per request (prefill overhead)
let a = 1.94e-4;       // s per prefill token
let b = 6.51e-9;       // s per prefill token per context token
let omega = 0.057;     // s per decode iteration
let policy = 3;
let keep = 1;          // 0: drop a finished session's blocks

pool live { cap cap; }
pool slots { cap B; admit via engine; }
pool kv {
  cap C;
  block bs;
  preempt lifo;
  evict by (policy == 5 ? 0 : queued,
            policy == 0 ? size
            : policy == 1 ? (queued ? 1 : p) * (a * size + b * size * size / 2) / size
            : policy == 2 ? (queued ? 1 : p)
                * price(engine, c0 + a * nm + b * nm * (size + nm / 2), a * size + b * size * size / 2) / size
            : policy == 3 ? (queued ? 1 : p)
                * price(engine, c0 + a * nm + b * nm * (size + nm / 2), a * size + b * size * size / 2)
                / (size * (queued ? 1 : Z))
            : policy == 4 ? (queued ? 1 : p)
                * price(engine, c0 + a * nm + b * nm * (size + nm / 2), a * bs + b * bs * (size - bs / 2))
                / (bs * (queued ? 1 : Z))
            : last);
}
stage engine : step {
  budget max(ndec, floor(omega / a));   // whole tokens
  cost max(omega, ntok * a + b * attn);
  memory kv;
}
stage tool : delay;

workload {
  arrive poisson(Lambda);
  init {
    set doc = ~bernoulli(0.5);          // class: 0 agent, 1 document
    set p = doc ? 0.3 : 0.95;
    set Z = doc ? 2 : 6;
    set nm = doc ? 500 : 800;           // mean append (the price's S^hit)
  }
}

session {
  set t_arr = now;
  hold live (1) {
    observe entry_wait = now - t_arr;
    set K = 0;
    set cold = 1;
    loop {
      set n = cold ? ceil(doc ? ~uniform(15000, 30000) : ~uniform(4000, 8000))
                   : ceil(doc ? ~exp(500) : ~exp(800));
      set o = ceil(~exp(300));
      set t0 = now;
      set prompt = K + n;
      set hm0 = cold ? 0 : floor(min(K - 1, prompt - 1) / bs) * bs;
      hold slots (1), kv (min(cachedin(kv), hm0)
                          + min(prompt - min(cachedin(kv), hm0), budget_left(engine)))
                      reserve (prompt)
           reuse (hm0) {
        set c = cached;
        set m = prompt - c;
        run engine prefill (ceil(c0 / a));
        run engine prefill (m) growing kv;
        observe ttft = now - t0;
        branch (!cold) {
          observe hit = c >= hm0;
          observe reused = hm0 > 0 ? c / hm0 : 1;
        }
        run engine decode (o - 1) growing kv;
      } cache (prompt + o - 1);
      observe response = now - t0;
      set K = prompt + o;
      set cold = 0;
      branch (K > maxctx) { branch (keep) { end; } else { drop kv; end; } }
      run tool (~exp(Z));
      branch with (p) { } else { branch (keep) { end; } else { drop kv; end; } }
    }
  }
}

run { horizon 21000; warmup 1000; seed 1; }
