// Paper's open/closed sampled-work queue with session feedback. The adapter
// (sim.batch) chooses the server kind, gives the defs their bodies (`defs=`)
// and sets the exact batch cap; the workload (`workloads/batch_sampled.sq`)
// draws each turn's work, and the adapter chooses its arrival kind.
use "std/args";

fn main() {
  let B = args.number("B", inf);
  let beta = args.number("beta", 0);
  let phi_cap = args.number("phi_cap", inf);
  let service_rate = args.number("service_rate", 1);

  // the PS capacity at `present` turns
  def capacity() { service_rate }

  pool slots { cap B; }
  stage svc : ps(capacity());

  server (prefill, decode) {
    set ready = now;
    hold slots (cost(slots, 1)) {
      observe wait = now - ready;
      run svc (cost(svc, prefill));
      observe ttft = now - ready;
      if (decode > 0) { run svc (cost(svc, decode)); }
    }
    observe response = now - ready;
    observe work = prefill + decode;
  }
}
