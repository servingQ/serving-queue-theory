{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/post-edit.sh",
            "timeout": 300,
            "statusMessage": "Rebuilding Lean / linting Python / checking paper refs\u2026"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "ref/vllm"
    ]
  },
  "model": "fable",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  }
}
