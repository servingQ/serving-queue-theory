// Sandwich check: vLLM v1 step engine (A100 cost fit), prefill only (o = 1),
// Poisson arrivals, no prefix cache, no memory limit.
use "std/args";

fn main() {
  let p_long = args.number("p_long", 0.2);
  let n_short = args.number("n_short", 64);
  let n_long = args.number("n_long", 2048);
  let B = args.number("B", 512);
  let max_seqs = args.number("max_seqs", 100000);
  let bs = args.number("bs", 16);
  let c_it = args.number("c_it", 0.004);
  let a = args.number("a", 5.1527e-5);
  let b = args.number("b", 4.0196e-9);

  device gpu { kv cap 1e12; }
  engine vllm on gpu {
    reqs cap max_seqs;
    tokens cap B;
    scheduler {
      advance running;
      admit waiting while (running.preempted == 0)
        taking reqs (1), kv (min(request.known, budget_left(vllm))) reserve (request.known);
    }
    worker {
      forward (c_it + a * batch.prefilled + b * batch.attention);
    }
  }
  pool reqs on vllm { queue fifo; }
  pool kv on gpu { block bs; evict lru; preempt lifo; }

  server (u) {
    set t0 = now;
    set m = u < p_long ? n_long : n_short;
    observe arr = t0;
    observe prompt_len = m;
    vllm (m, 1);   // the prefill samples the one output token
    observe ttft = vllm.first - t0;
    drop kv;
  }
}
