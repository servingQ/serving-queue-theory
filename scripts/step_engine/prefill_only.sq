// Sandwich check: vLLM v1 step engine (A100 cost fit), prefill only (o = 1),
// Poisson arrivals, no prefix cache, no memory limit.
use "std/args";

fn main() {
  let Lambda = args.number("Lambda", 10);
  let p_long = args.number("p_long", 0.2);
  let n_short = args.number("n_short", 64);
  let n_long = args.number("n_long", 2048);
  let B = args.number("B", 512);
  let max_seqs = args.number("max_seqs", 100000);
  let bs = args.number("bs", 16);
  let c_it = args.number("c_it", 0.004);
  let a = args.number("a", 5.1527e-5);
  let b = args.number("b", 4.0196e-9);

  pool reqs { cap max_seqs; admit via engine; }
  pool kv { cap 1e12; block bs; evict lru; preempt lifo; }
  stage engine : step { budget B; cost c_it + a * prefilled + b * attention; memory kv; }

  workload {
    arrive poisson(Lambda);
    init { set u = ~uniform(0, 1); }
  }

  server {
    set t0 = now;
    set m = u < p_long ? n_long : n_short;
    observe arr = t0;
    observe size = m;
    hold reqs (cost(reqs, 1)), kv (cost(kv, min(m, budget_left(engine)))) reserve (cost(kv, m)) {
      prefill (m) growing kv;
      observe ttft = now - t0;
    }
    drop kv;
  }
}
