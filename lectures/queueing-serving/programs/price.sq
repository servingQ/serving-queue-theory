// serQ v0.1.0: miss-price check; previous full-prompt gate retained.
use "std/args";

fn main() {
  let pmiss = args.number("pmiss", 0.2);       // baseline miss share
  let delta = args.number("delta", 0);         // forced misses
  let hitn = args.number("hitn", 512);        // tokens prefilled by a hit
  let missn = args.number("missn", 5120);      // tokens prefilled by a miss
  let o = args.number("o", 8);             // output tokens
  let B = args.number("B", 64);            // batch cap
  let bs = args.number("bs", 16);
  let a = args.number("a", 1.94e-4);       // s per prefill token
  let b = args.number("b", 6.51e-9);       // s per prefill token per context token
  let omega = args.number("omega", 0.057);     // s per decode iteration

  device gpu { kv cap 1e12; }
  engine vllm on gpu {
    slots cap B;
    tokens cap max(running.decoding, floor(omega / a));
    scheduler {
      advance running;
      admit waiting while (running.preempted == 0)
        taking slots (1), kv (min(request.known, budget_left(vllm))) reserve (request.known);
    }
    worker {
      forward (max(omega, batch.tokens * a + b * batch.attention));
    }
  }
  pool slots on vllm { queue fifo; }
  pool kv on gpu { block bs; preempt lifo; evict lru; }

  server (u) {
    set t0 = now;
    set m = u < pmiss + delta ? missn : hitn;
    observe work = a * m + b * m * m / 2;
    vllm (m, o);
    observe ttft = vllm.first - t0;
    observe response = now - t0;
    drop kv;
  }
}
