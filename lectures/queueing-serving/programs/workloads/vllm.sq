// The client of `vllm.sq`: sessions arrive, each turn brings a prompt of
// n new tokens on a context of K and wants o tokens back, and after a turn
// the session calls a tool and comes back with probability p. Nothing here
// is vLLM.
use "std/args";

let Lambda = args.number("Lambda", 0.3);      // sessions per second
let p = args.number("p", 0.9);           // continue after a turn
let Z = args.number("Z", 3.0);           // tool time (s)

// --8<-- [start:workload]
workload {
  arrive poisson(Lambda);
  init { set K = 0; }
  turn {
    // token counts are whole numbers: a draw is rounded up (the engine
    // ran a fractional output's last token as a whole decode step)
    set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
    set o = ceil(~exp(200)) + 1;
    set more = ~bernoulli(p);
  }
  send (K, n, o);
  session {
    loop {
      turn;
      set K = K + n + o;
      if (more) { tool (~exp(Z)); } else { end; }
    }
  }
}
// --8<-- [end:workload]
