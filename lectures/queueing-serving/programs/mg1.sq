// M/G/1 FIFO (paper §2, `prop:pk`): Poisson turns at rate `lam`, one
// server, i.i.d. service of mean `mean_s` drawn by `law`
// (0 deterministic, 1 exponential, 2 Erlang-4, 3 balanced H2 with `cv2`).
// The turns are `workloads/mg1.sq`.

fn main() {
  stage svc : fifo;

  server (s, t0) {
    run svc (cost(svc, s));
    observe sojourn = now - t0;
    observe wait = now - t0 - s;
    observe service = s;
  }
}
